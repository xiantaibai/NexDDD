{
  "$schema": "http://json.schemastore.org/template",
  "author": "YSCore",
  "classifications": [
    "Web",
    "DDD",
    "YSCore"
  ],
  "identity": "YSCore.Templates.Ddd",
  "name": "YSCore DDD Project",
  "shortName": "tpl",
  "sourceName": "Company.Project",
  "defaultName": "Company.Project",
  "description": "创建包含 Contracts、Application、Domain、Infrastructure、WebApi 和领域测试的 YSCore DDD 项目。",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "yscoreVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.2.9",
      "displayName": "YSCore 包版本",
      "description": "生成项目引用的 YSCore NuGet 包版本。",
      "replaces": "YSCORE_VERSION"
    }
  },
  "primaryOutputs": [
    {
      "path": "Company.Project.sln"
    },
    {
      "path": "src/Company.Project.WebApi/Company.Project.WebApi.csproj"
    }
  ]
}
