{
  "YSCore": {
    "Observability": {
      "Enabled": true,
      "ServiceName": "YSCore.ObservabilityDemoApi",
      "EnableFrameworkDiagnostics": true,
      "Tracing": {
        "Enabled": true,
        "SamplingRatio": 1.0,
        "RecordException": true
      },
      "Metrics": {
        "Enabled": true,
        "ExportIntervalMilliseconds": 5000
      },
      "Logging": {
        "Enabled": true,
        "IncludeScopes": true,
        "IncludeFormattedMessage": true,
        "ParseStateValues": true
      },
      "Otlp": {
        "Enabled": true,
        "Endpoint": "http://47.96.225.52:4318",
        "Protocol": "HttpProtobuf"
      }
    }
  },
  "OpenTelemetry": {
    "OtlpExporterEndpoint": "http://47.96.225.52:4318",
    "Protocol": "HttpProtobuf"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
