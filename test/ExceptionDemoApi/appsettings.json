{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalizationSettings": {
    "ResourcesPath": "Resources",
    "SupportedCultures": [ "zh-CN", "en-US" ],
    "DefaultCulture": "zh-CN",
    "LanguageFilePrefix": "Lang",
    "AssemblyName": "ExceptionDemoApi",
    "DateTimeFormatCulture": "zh-CN"
  },
  "FriendlyExceptionSettings": {
    "DefaultErrorCode": "demo.unknown",
    "DefaultErrorMessage": "demo.unknown",
    "PropagateInnerException": true,
    "ErrorCodeMessages": {
      "demo.business": "demo.business",
      "demo.validation": "demo.validation",
      "demo.internal.public": "demo.internal.public",
      "demo.internal.private": "demo.internal.private",
      "demo.unknown": "demo.unknown"
    }
  },
  "UnifyResultSettings": {
    "Return200StatusCodes": [ 401, 403 ],
    "AdaptStatusCodes": [ [ 400, 404, 500 ] ]
  }
}
